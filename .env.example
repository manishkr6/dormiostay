# Backend — apps/api. Names only; fill values in a gitignored local env file.
# Runtime environment: development, staging, or production.
APP_ENV=
# Pooled Neon URL for the non-superuser application role.
DATABASE_URL=
# Direct Neon URL for the separate migration role.
DATABASE_URL_DIRECT=
# Redis protocol URL; choose this OR the two REST variables below consistently.
REDIS_URL=
# Upstash REST endpoint (alternative to REDIS_URL).
UPSTASH_REDIS_REST_URL=
# Server-only Upstash REST credential (alternative to REDIS_URL).
UPSTASH_REDIS_REST_TOKEN=
# Name of the HttpOnly session cookie.
SESSION_COOKIE_NAME=
# Tenant/owner idle session lifetime in minutes.
SESSION_IDLE_MINUTES=
# Tenant/owner absolute session lifetime in days.
SESSION_ABSOLUTE_DAYS=
# Admin idle session lifetime in minutes.
ADMIN_SESSION_IDLE_MINUTES=
# Exact frontend origin for CORS and Origin validation; no wildcards.
FRONTEND_ORIGIN=
# Random secret for signing CSRF tokens.
CSRF_SECRET=
# Encryption key for admin TOTP secrets; back up securely.
TOTP_ENCRYPTION_KEY=
# Server-only Brevo transactional email credential.
BREVO_API_KEY=
# Verified email sender address.
EMAIL_FROM_ADDRESS=
# Email sender display name.
EMAIL_FROM_NAME=
# Public support contact address.
PUBLIC_CONTACT_EMAIL=
# Server-only geocoding key, separate from the browser map key.
GEOAPIFY_API_KEY=
# Cloudinary account cloud name.
CLOUDINARY_CLOUD_NAME=
# Server-only Cloudinary API key for signed uploads.
CLOUDINARY_API_KEY=
# Server-only Cloudinary signing secret.
CLOUDINARY_API_SECRET=
# Cloudflare account owning the private R2 bucket.
R2_ACCOUNT_ID=
# Server-only R2 access key identifier.
R2_ACCESS_KEY_ID=
# Server-only R2 secret access key.
R2_SECRET_ACCESS_KEY=
# Private verification-document bucket name.
R2_BUCKET_PRIVATE=
# Short presigned URL lifetime in seconds.
R2_PRESIGN_EXPIRY_SECONDS=
# AI provider selected by server configuration.
AI_PROVIDER=
# AI model identifier selected by server configuration.
AI_MODEL=
# Server-only Gemini API credential.
GEMINI_API_KEY=
# Initial per-user daily AI quota.
AI_DEFAULT_DAILY_LIMIT_PER_USER=
# Initial platform-wide daily AI quota.
AI_GLOBAL_DAILY_LIMIT=
# Backend error-tracking DSN.
SENTRY_DSN=
# Email for the one-time admin bootstrap; never supply a default password.
INITIAL_ADMIN_EMAIL=

# Frontend — apps/web. All VITE_ values are public and baked into builds.
# Canonical website URL for links and SEO.
VITE_SITE_URL=
# Public map tile key; restrict by domain and keep separate from server key.
VITE_GEOAPIFY_MAP_KEY=
# Public browser error-tracking DSN.
VITE_SENTRY_DSN=
# Public Cloudinary cloud name for image URLs.
VITE_CLOUDINARY_CLOUD_NAME=

# Local Docker Compose only — development values; never use production credentials.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Optional local Compose overrides.
POSTGRES_DB=
POSTGRES_USER=

# Opt-in T-03 tests only; exact approved local disposable database name.
TEST_DATABASE_NAME=
# Administrator URL for that disposable database; never the development database.
TEST_DATABASE_URL=
# Restricted dormiostay_app URL for the same disposable database.
TEST_APP_DATABASE_URL=
